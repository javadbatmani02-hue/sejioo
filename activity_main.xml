<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سجیو"
            android:textColor="#7CE0C0"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="دستیار صوتی فارسی"
            android:textColor="#8A94A6"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A2230"
            android:padding="14dp"
            android:text="سجیو خاموش است"
            android:textColor="#E6EDF3"
            android:textSize="15sp"
            android:layout_marginBottom="18dp" />

        <TextView style="@style/Label" android:text="اسم تو" />
        <EditText android:id="@+id/etName" style="@style/Field"
            android:hint="مثلاً محمد" android:inputType="text" />

        <TextView style="@style/Label" android:text="کلمهٔ بیدارباش" />
        <EditText android:id="@+id/etWake" style="@style/Field"
            android:hint="سجیو" android:inputType="text" />

        <TextView style="@style/Label" android:text="آدرس سرویس هوش مصنوعی" />
        <EditText android:id="@+id/etUrl" style="@style/Field"
            android:hint="https://api.example.com/v1/chat/completions"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="کلید API" />
        <EditText android:id="@+id/etKey" style="@style/Field"
            android:hint="sk-..." android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="نام مدل" />
        <EditText android:id="@+id/etModel" style="@style/Field"
            android:hint="gpt-4o-mini" android:inputType="text" />

        <TextView style="@style/Label" android:text="چیزهایی که سجیو یاد گرفته" />
        <EditText android:id="@+id/etMemory" style="@style/Field"
            android:hint="هر خط یک نکته؛ مثلاً: از فحش بدش می‌آید"
            android:inputType="textMultiLine" android:minLines="3" android:gravity="top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="#2BB673"
                android:text="روشن کردن سجیو"
                android:textColor="#04140C" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:backgroundTint="#2A3444"
                android:text="خاموش"
                android:textColor="#E6EDF3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="برای اینکه سجیو با صفحهٔ خاموش هم بیدار بماند: تنظیمات ← باتری ← اجرای برنامه در پس‌زمینه ← سجیو را روی «دستی/مجاز» بگذار و Battery Optimization را برایش خاموش کن."
            android:textColor="#6B7686"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
