<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zizi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#0E1116</item>
        <item name="android:navigationBarColor">#0E1116</item>
        <item name="colorPrimary">#2BB673</item>
        <item name="colorAccent">#7CE0C0</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8A94A6</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#1A2230</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#E6EDF3</item>
        <item name="android:textColorHint">#4E5A6B</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
